aws_region      = "ap-south-1"
project_name    = "za-cw14"
vpc_cidr        = "10.40.0.0/16"
instance_type   = "t3.micro"
min_size        = 2
desired_capacity = 2
max_size        = 4

# Keep both false to practise creating these two objects in the AWS Console.
# Set either to true if you want Terraform to own that object instead.
create_target_tracking_policy_with_terraform = false
create_5xx_alarm_with_terraform              = false

# Restrict this to your classroom/home public IP CIDR when practical.
allowed_http_cidrs = ["0.0.0.0/0"]
