{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "CreateOnlyBoundedRoles",
			"Effect": "Allow",
			"Action": "iam:CreateRole",
			"Resource": "arn:aws:iam::<ACCOUNT_ID>:role/AppDeployment-*",
			"Condition": {
				"ArnEquals": {
					"iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT_ID>:policy/Developer-Permissions-Boundary"
				}
			}
		},
		{
			"Sid": "ManageCreatedRolePolicies",
			"Effect": "Allow",
			"Action": [
				"iam:AttachRolePolicy",
				"iam:PutRolePolicy"
			],
			"Resource": "arn:aws:iam::<ACCOUNT_ID>:role/AppDeployment-*"
		},
		{
			"Sid": "ViewCreatedRoles",
			"Effect": "Allow",
			"Action": [
				"iam:GetRole",
				"iam:ListAttachedRolePolicies"
			],
			"Resource": "arn:aws:iam::<ACCOUNT_ID>:role/AppDeployment-*"
		}
	]
}